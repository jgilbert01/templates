{
  "name": "template-db-ingress-gateway",
  "private": true,
  "scripts": {
    "clean": "rimraf -rf .nyc_output/ .convivio/ .webpack/ .serverless/ coverage/",
    "lint": "npm run lint:js",
    "lint:js": "eslint --fix --format=node_modules/eslint-formatter-pretty .",
    "lint:staged": "lint-staged",
    "pretest": "npm run clean && npm run lint",
    "test": "better-npm-run test",
    "test:int": "better-npm-run test:int",
    "test:cvo": "DEBUG=cvo:* cvo package -r us-west-2 -s dev",
    "start": "better-npm-run start",
    "dp:dev:e": "cvo deploy -r us-west-2 -s dev",
    "dp:dev:w": "cvo deploy -r us-west-2 -s dev",
    "dp:prd:e": "cvo deploy -r us-west-2 -s prd",
    "dp:prd:w": "cvo deploy -r us-west-2 -s prd"
  },
  "betterScripts": {
    "start": {
      "command": "cvo start -r us-west-2 -s dev",
      "env": {
        "DEBUG": "cvo:*"
      }
    },
    "test": {
      "command": "nyc mocha --recursive \"./test/unit/**/*.test.js\"",
      "env": {
        "NODE_ENV": "test",
        "STAGE": "dev",
        "AES": "false",
        "AWS_REGION": "us-west-2",
        "MASTER_KEY_ALIAS": "alias/template-global-resources-dev",
        "KMS_REGIONS": "us-west-2,us-east-1"
      }
    },
    "test:int": {
      "command": "start-test http://localhost:3001/ping 'mocha --timeout 20000 --require @babel/register --recursive ./test/helper.js \"./test/int/**/*.test.js\"'",
      "env": {
        "NODE_ENV": "test",
        "AES": "false",
        "AWS_REGION": "us-west-2",
        "MASTER_KEY_ALIAS": "alias/template-global-resources-dev",
        "KMS_REGIONS": "us-east-1,us-west-2",
        "DEBUG": "start-server-and-test,nock.*,cvo:offline:*,cvo:testing:lambda,handler:*,pl:*"
      }
    }
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/client-eventbridge": "^3.450.0",
    "@aws-sdk/client-kms": "^3.450.0",
    "@aws-sdk/client-lambda": "^3.450.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/client-secrets-manager": "^3.450.0",
    "@aws-sdk/client-sns": "^3.450.0",
    "@aws-sdk/client-sqs": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "@aws-sdk/util-dynamodb": "^3.450.0",
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/register": "^7.23.3",
    "@convivio/cli": "file:../../cli",
    "@convivio/serverless-plugin": "file:../../serverless-plugin",
    "@convivio/testing": "file:../../testing",
    "aws-assume-role-cicd": "^2.0.0",
    "aws-sdk-client-mock": "^3.0.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^6.1.1",
    "better-npm-run": "^0.1.1",
    "chai": "^4.3.6",
    "eslint": "^8.53.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-formatter-pretty": "^4.1.0",
    "eslint-plugin-import": "^2.26.0",
    "husky": "^8.0.1",
    "lint-staged": "^15.1.0",
    "mocha": "^10.0.0",
    "nock": "^13.2.4",
    "nyc": "^15.1.0",
    "serverless": "^3.37.0",
    "serverless-aws-describe-plugin": "^1.0.0",
    "serverless-kinesis-esm-plugin": "^1.0.1",
    "sinon": "^17.0.0",
    "sinon-chai": "^3.7.0",
    "start-server-and-test": "^2.0.3",
    "supertest": "^6.2.3",
    "webpack": "^5.89.0",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.2",
    "@smithy/node-http-handler": "^2.1.9",
    "@smithy/util-retry": "^2.1.1",
    "@smithy/util-stream": "^2.1.1",
    "aws-kms-ee": "^1.0.6",
    "aws-lambda-stream": "^1.0.29",
    "bluebird": "^3.7.2",
    "debug": "^4.3.4",
    "highland": "^2.13.5",
    "lambda-api": "^1.0.0",
    "lambda-api-utils": "^1.0.4",
    "lodash": "^4.17.21",
    "memory-cache": "^0.2.0",
    "moment": "^2.29.4",
    "uuid": "^9.0.1",
    "zoe": "^0.0.4"
  }
}
