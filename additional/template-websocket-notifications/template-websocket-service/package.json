{
  "name": "template-websocket-service",
  "private": true,
  "scripts": {
    "clean": "rimraf -rf .c8_output/ .serverless/ coverage/",
    "lint": "npm run lint:js",
    "lint:js": "eslint --fix --format=node_modules/eslint-formatter-pretty .",
    "lint:staged": "lint-staged",
    "pretest": "npm run clean && npm run lint",
    "test": "NODE_ENV=test AWS_REGION=us-west-2 c8 mocha --require @babel/register --recursive \"./test/unit/**/*.test.js\"",
    "build": "sls package --verbose -r us-west-2 -s np",
    "dp:np:w": "sls deploy --verbose -r us-west-2 -s np --force",
    "dp:np:e": "sls deploy --verbose -r us-east-1 -s np --force",
    "dp:prd:w": "sls deploy --verbose -r us-west-2 -s prd --force",
    "dp:prd:e": "sls deploy --verbose -r us-east-1 -s prd --force"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.17.10",
    "@babel/eslint-parser": "^7.17.0",
    "@babel/plugin-transform-runtime": "^7.17.10",
    "@babel/preset-env": "^7.17.7",
    "@babel/register": "^7.17.7",
    "aws-sdk-client-mock": "^3.0.0",
    "c8": "^10.0.0",
    "chai": "^4.3.6",
    "eslint": "^8.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-formatter-pretty": "^4.1.0",
    "eslint-plugin-import": "^2.26.0",
    "mocha": "^11.3.0",
    "rimraf": "^5.0.0",
    "serverless": "^4.0.0",
    "serverless-offline": "^14.0.0",
    "sinon": "^14.0.0",
    "sinon-chai": "^3.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@babel/runtime": "^7.17.9",
    "aws-lambda-stream": "^1.2.0",
    "debug": "^4.0.0"
  }
}
